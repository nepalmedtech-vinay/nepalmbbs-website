---
// Lifted verbatim from the single-page build (Phase 2).
---
<button class="admin-access-btn" data-act="click" data-do='[["openAdmin"]]' aria-label="Admin Panel">⚙️ Admin</button>

<!-- TOAST -->
<div id="toast"></div>
<!-- ADMIN PANEL -->
<div id="admin-overlay">
<div class="admin-box">
  <div class="admin-top">
    <div><h2>⚙️ NepalMBBS Admin Panel</h2><p>Supabase-powered • All changes apply across all devices instantly</p></div>
    <button class="admin-x" data-act="click" data-do='[["closeAdmin"]]'>×</button>
  </div>
  <div id="admin-login-view">
    <h3>🔐 Secure Admin Login</h3>
    <p>Enter your password to access the full control panel</p>
    <div class="admin-login-form">
      <div class="ff" style="margin-bottom:12px"><label class="a-label" for="admin-email">Email</label><input type="email" id="admin-email" class="a-inp" placeholder="you@nepalmbbs.in" autocomplete="username" style="font-size:15px"></div><div class="ff" style="margin-bottom:12px"><label class="a-label" for="admin-pass">Password</label><input type="password" id="admin-pass" class="a-inp" placeholder="Your password" data-act="enter" data-do='[["doAdminLogin"]]' autocomplete="current-password" style="font-size:15px;letter-spacing:.05em"></div>
      <button class="a-btn a-btn-primary" data-act="click" data-do='[["doAdminLogin"]]' style="width:100%;justify-content:center">Sign in →</button><button class="a-btn" data-act="click" data-do='[["doAdminReset"]]' style="width:100%;justify-content:center;margin-top:8px">Forgot password</button>
      <div class="admin-err" id="admin-err"></div>
      <p style="margin-top:12px;font-size:12px;color:var(--muted)">Contact your system administrator for the admin password if you have forgotten it.</p>
    </div>
  </div>
  <div class="admin-body" id="admin-main" style="display:none">
    <div class="a-tabs">
      <button class="a-tab on" data-act="click" data-do='[["switchATab","@el","ap-dash"]]'>📊 Dashboard</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-content"]]'>✏️ Content</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-videos"]]'>🎥 Videos</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-tests"]]'>⭐ Testimonials</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-faq"]]'>❓ FAQ</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-leads"]]'>👥 Leads</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-colleges"]]'>🏥 Colleges</button>
      <button class="a-tab" data-act="click" data-do='[["switchATab","@el","ap-settings"]]'>⚙️ Settings</button>
    </div>

    <!-- DASHBOARD -->
    <div class="a-pane on" id="ap-dash">
      <div class="stat-grid" id="admin-stats">
        <div class="stat-box"><strong id="st-total">—</strong><span>Total Leads</span></div>
        <div class="stat-box"><strong id="st-today">—</strong><span>Today</span></div>
        <div class="stat-box"><strong id="st-mumbai">—</strong><span>Mumbai</span></div>
        <div class="stat-box"><strong id="st-nagpur">—</strong><span>Nagpur</span></div>
        <div class="stat-box"><strong id="st-nanded">—</strong><span>Nanded</span></div>
        <div class="stat-box"><strong id="st-nashik">—</strong><span>Nashik</span></div>
      </div>
      <div class="a-sect">
        <div class="a-label">Site Feature Toggles</div>
        <div class="a-toggle-row"><div class="a-toggle-info"><div class="a-toggle-title">🟡 Ticker Bar</div><div class="a-toggle-sub">Top announcement scrolling ticker</div></div><div class="switch on" id="sw-ticker" data-act="click" data-do='[["toggleFeature","@el","show_ticker","ticker-bar"]]'></div></div>
        <div class="a-toggle-row"><div class="a-toggle-info"><div class="a-toggle-title">💬 WhatsApp Float Buttons</div><div class="a-toggle-sub">WA Chat + Call floating buttons</div></div><div class="switch on" id="sw-wa" data-act="click" data-do='[["toggleFeature","@el","show_wa_float","wa-float-wrap"]]'></div></div>
        <div class="a-toggle-row"><div class="a-toggle-info"><div class="a-toggle-title">🤖 AI Chatbot</div><div class="a-toggle-sub">Bottom-right chat assistant</div></div><div class="switch on" id="sw-chat" data-act="click" data-do='[["toggleFeature","@el","show_chat","chat-wrap"]]'></div></div>
        <div class="a-toggle-row"><div class="a-toggle-info"><div class="a-toggle-title">📋 Hero Lead Form</div><div class="a-toggle-sub">Registration form on homepage</div></div><div class="switch on" id="sw-form" data-act="click" data-do='[["toggleFeature","@el","show_lead_form","hform-area"]]'></div></div>
      </div>
      <div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["loadLeadsTable"]]'>📋 View All Leads</button><button class="a-btn a-btn-sec" data-act="click" data-do='[["exportCSV"]]'>📥 Export CSV</button><button class="a-btn a-btn-sec" data-act="click" data-do='[["loadDashboard"]]'>🔄 Refresh Stats</button></div>
    </div>

    <!-- CONTENT -->
    <div class="a-pane" id="ap-content">
      <div class="a-sect"><div class="a-label">Hero Badge Text (Live Announcement)</div><input type="text" class="a-inp" id="a-hero-badge" placeholder="e.g. NEET 2025 Results Out — Nepal Admissions Open"><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveSet","hero_badge","a-hero-badge","hero-badge-text"]]'>💾 Save</button></div></div>
      <div class="a-sect"><div class="a-label">Hero Heading (H1)</div><input type="text" class="a-inp" id="a-hero-h1" placeholder="e.g. After NEET — Nepal MBBS — The Smartest Path"><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveHeroH1"]]'>💾 Save</button></div></div>
      <div class="a-sect"><div class="a-label">Hero Subtext</div><textarea class="a-inp" id="a-hero-sub" placeholder="Hero description text"></textarea><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveSet","hero_sub","a-hero-sub","hero-sub"]]'>💾 Save</button></div></div>
      <div class="a-sect"><div class="a-label">Phone Number (appears sitewide)</div><input type="text" class="a-inp" id="a-phone" placeholder="+91 XXXXX XXXXX"><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["savePhone"]]'>💾 Save Sitewide</button></div></div>
      <div class="a-sect"><div class="a-label">WhatsApp Number (all WA buttons)</div><input type="text" class="a-inp" id="a-wa-num" placeholder="91XXXXXXXXXX (country code, no +)"><p style="font-size:11px;color:var(--muted);margin-top:4px">Updates ALL WhatsApp Chat + Call links across the entire site</p><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveWANum"]]'>💾 Save</button><button class="a-btn a-btn-sec" data-act="click" data-do='[["testWACall"]]'>📲 Test WA Call</button></div></div>
      <div class="a-sect"><div class="a-label">Add Ticker Announcement</div><input type="text" class="a-inp" id="a-ticker-new" placeholder="New announcement text..."><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["addTicker"]]'>Add to Ticker</button></div></div>
      <div class="a-sect"><div class="a-label">Footer About Text</div><textarea class="a-inp" id="a-footer-about" placeholder="Footer description"></textarea><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveSet","footer_about","a-footer-about","footer-desc"]]'>💾 Save</button></div></div>
    </div>

    <!-- VIDEOS -->
    <div class="a-pane" id="ap-videos">
      <div class="a-sect"><div class="a-label">NMC India Guidelines Video (shown in Guidelines tab)</div><input type="text" class="a-inp" id="a-nmc-url" placeholder="YouTube embed URL: https://www.youtube.com/embed/VIDEO_ID"><input type="text" class="a-inp" id="a-nmc-title" placeholder="Video title" style="margin-top:8px"><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveNMCVid"]]'>💾 Save to Supabase</button><button class="a-btn a-btn-danger" data-act="click" data-do='[["removeNMCVid"]]'>Remove</button></div></div>
      <div class="a-sect"><div class="a-label">Add Video to Videos Tab</div>
      <div class="a-row" style="margin-bottom:8px">
        <div>
          <label class="a-label" style="margin-bottom:4px">College (for filtering)</label>
          <select class="a-inp" id="a-vid-college">
            <option value="all">All / General</option>
            <option value="kmc">Kathmandu Medical College</option>
            <option value="kist">KIST Medical College</option>
            <option value="gandaki">Gandaki Medical College</option>
            <option value="manipal">Manipal Pokhara</option>
            <option value="cms">CMS Chitwan</option>
            <option value="nobel">Nobel Medical College</option>
            <option value="nmc-b">National Medical College</option>
            <option value="ucms">UCMS</option>
            <option value="lumbini">Lumbini Medical College</option>
            <option value="bpkihs">BPKIHS</option>
            <option value="chitwan">Chitwan Medical College</option>
            <option value="birat">Birat Medical College</option>
            <option value="janaki">Janaki Medical College</option>
          </select>
        </div>
      </div>
<p style="font-size:11.5px;color:var(--muted);margin-bottom:8px">For YouTube: paste the video page URL (e.g. https://youtu.be/VIDEO_ID or https://www.youtube.com/watch?v=VIDEO_ID) — system auto-converts to embed format.</p>
<div class="a-row"><input type="text" class="a-inp" id="a-vid-url" placeholder="YouTube URL or embed URL"><input type="text" class="a-inp" id="a-vid-title" placeholder="Video title"></div><input type="text" class="a-inp" id="a-vid-desc" placeholder="Short description (optional)" style="margin-top:8px"><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["addVideo"]]'>💾 Add to Supabase</button></div></div>
      <div class="a-sect"><div class="a-label">Current Videos (from Supabase)</div><div id="admin-vid-list"><p style="color:var(--muted);font-size:13px">Loading...</p></div></div>
    </div>

    <!-- TESTIMONIALS -->
    <div class="a-pane" id="ap-tests">
      <div class="a-sect"><div class="a-label">Add New Testimonial</div><div class="a-row"><input type="text" class="a-inp" id="a-test-name" placeholder="Student Name"><input type="text" class="a-inp" id="a-test-city" placeholder="City → College Name"></div><div class="a-row" style="margin-top:8px"><input type="text" class="a-inp" id="a-test-year" placeholder="e.g. 2nd Year MBBS"><select class="a-inp" id="a-test-stars"><option value="5">★★★★★ (5 stars)</option><option value="4">★★★★ (4 stars)</option></select></div><textarea class="a-inp" id="a-test-quote" placeholder="Student testimonial quote..." style="margin-top:8px"></textarea><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["addTestimonial"]]'>💾 Add to Supabase</button></div></div>
      <div class="a-sect"><div class="a-label">Current Testimonials</div><div id="admin-test-list"><p style="color:var(--muted);font-size:13px">Loading...</p></div></div>
    </div>

    <!-- FAQ ADMIN -->
    <div class="a-pane" id="ap-faq">
      <div class="a-sect"><div class="a-label">Add New FAQ</div><input type="text" class="a-inp" id="a-faq-q" placeholder="Question"><textarea class="a-inp" id="a-faq-a" placeholder="Answer" style="margin-top:8px"></textarea><div class="a-row" style="margin-top:8px"><select class="a-inp" id="a-faq-cat"><option value="General">General</option><option value="Admission & Eligibility">Admission & Eligibility</option><option value="Fees & Finance">Fees & Finance</option><option value="Career & Future">Career & Future</option><option value="Life & Safety">Life & Safety</option></select><input type="number" class="a-inp" id="a-faq-order" placeholder="Sort order (1,2,3...)" min="1"></div><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["addFAQ"]]'>💾 Add to Supabase</button></div></div>
      <div class="a-sect"><div class="a-label">Current Custom FAQs (from Supabase)</div><div id="admin-faq-list"><p style="color:var(--muted);font-size:13px">Loading...</p></div></div>
      <p style="font-size:12px;color:var(--muted);margin-top:8px">Note: Default FAQs are hardcoded. Added FAQs appear at the bottom of each category.</p>
    </div>

    <!-- LEADS -->
    <div class="a-pane" id="ap-leads">
      <div class="a-btns" style="margin-bottom:16px"><button class="a-btn a-btn-primary" data-act="click" data-do='[["loadLeadsTable"]]'>🔄 Refresh</button><button class="a-btn a-btn-sec" data-act="click" data-do='[["exportCSV"]]'>📥 Export CSV</button></div>
      <div style="overflow-x:auto"><table class="leads-tbl" id="leads-table"><thead><tr><th>#</th><th>Name</th><th>Phone</th><th>City</th><th>NEET</th><th>Category</th><th>Stage</th><th>Source</th><th>Date</th></tr></thead><tbody id="leads-tbody"><tr><td colspan="9" style="text-align:center;color:var(--muted);padding:20px">Click Refresh to load leads</td></tr></tbody></table></div>
    </div>

    <!-- COLLEGES ADMIN -->
    <div class="a-pane" id="ap-colleges">

      {/* Media and notices. These write to college_media and college_notices,
          which are read by live.js in the visitor's browser — so a save here
          is visible on the site immediately, with no rebuild and no deploy.

          Deliberately separate from the College Cards block below it, which
          writes to site_colleges and only takes effect at the next build.
          That is not an inconsistency to tidy up later: facts go through a
          build so the verify suite sees them, and photos and notices do not.
          The two blocks say so on the page, so whoever uses this knows which
          kind of change they just made. */}
      <div class="a-sect">
        <div class="a-label">📸 Photos &amp; video — live, no rebuild</div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:12px">
          Appears on the college's own page within seconds of saving. Paste an
          image URL or a video link.
        </p>
        <select class="a-inp" id="a-media-college"><option value="">Select a college…</option></select>
        <div class="a-row" style="margin-top:8px">
          <select class="a-inp" id="a-media-kind">
            <option value="photo">Photo</option>
            <option value="video">Video link</option>
          </select>
          <input type="text" class="a-inp" id="a-media-url" placeholder="https://… image or video URL">
        </div>
        <div class="a-row" style="margin-top:8px">
          <input type="text" class="a-inp" id="a-media-caption" placeholder="Caption (also used as the image's alt text)">
          <input type="text" class="a-inp" id="a-media-credit" placeholder="Credit — who supplied it">
        </div>
        <div class="a-btns">
          <button class="a-btn a-btn-primary" data-act="click" data-do='[["addCollegeMedia"]]'>Save — goes live now</button>
          <button class="a-btn a-btn-sec" data-act="click" data-do='[["loadCollegeMedia"]]'>Refresh list</button>
        </div>
        <div id="a-media-list" style="margin-top:12px"></div>
      </div>

      <div class="a-sect">
        <div class="a-label">📢 Notices — live, no rebuild</div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:12px">
          Leave the college blank for a notice on every page. An end date is
          optional; without one the notice runs until you unpublish it.
        </p>
        <select class="a-inp" id="a-notice-college"><option value="">Site-wide (all pages)</option></select>
        <input type="text" class="a-inp" id="a-notice-title" placeholder="Notice title" style="margin-top:8px">
        <textarea class="a-inp" id="a-notice-body" placeholder="Body (optional)" style="margin-top:8px"></textarea>
        <div class="a-row" style="margin-top:8px">
          <select class="a-inp" id="a-notice-level">
            <option value="info">Information</option>
            <option value="provisional">Provisional — may change</option>
            <option value="caution">Caution — act carefully</option>
          </select>
          <input type="date" class="a-inp" id="a-notice-ends" title="Stops showing after this date">
        </div>
        <div class="a-btns">
          <button class="a-btn a-btn-primary" data-act="click" data-do='[["addCollegeNotice"]]'>Publish — goes live now</button>
          <button class="a-btn a-btn-sec" data-act="click" data-do='[["loadCollegeNotices"]]'>Refresh list</button>
        </div>
        <div id="a-notice-list" style="margin-top:12px"></div>
      </div>

      <div class="a-sect">
        <div class="a-label">🏥 College Cards Management — takes effect at the next build</div>
        <p style="font-size:13px;color:var(--muted);margin-bottom:16px">Add or update college details. Fee amounts are hidden from public view — available on contact only.</p>
        <div class="a-row">
          <div>
            <label class="a-label">College Name</label>
            <input class="a-inp" id="ac-name" type="text" placeholder="e.g. Manipal College of Medical Sciences">
          </div>
          <div>
            <label class="a-label">Location / University</label>
            <input class="a-inp" id="ac-loc" type="text" placeholder="e.g. Pokhara | Kathmandu University">
          </div>
        </div>
        <div class="a-row" style="margin-top:10px">
          <div>
            <label class="a-label">Foreign Seats</label>
            <input class="a-inp" id="ac-seats" type="number" placeholder="e.g. 60">
          </div>
          <div>
            <label class="a-label">College Type</label>
            <select class="a-inp" id="ac-type">
              <option value="govt">Government</option>
              <option value="ku">KU Affiliated</option>
              <option value="tu">TU Affiliated</option>
            </select>
          </div>
        </div>
        <div class="a-row" style="margin-top:10px">
          <div>
            <label class="a-label">Official Website URL</label>
            <input class="a-inp" id="ac-web" type="url" placeholder="https://www.college.edu.np">
          </div>
          <div>
            <label class="a-label">Established Year</label>
            <input class="a-inp" id="ac-est" type="text" placeholder="e.g. 1994">
          </div>
        </div>
        <div style="margin-top:16px">
          <label class="a-label">Internal Fee Notes (Admin Only — Not Shown Publicly)</label>
          <textarea class="a-inp" id="ac-fees" rows="3" placeholder="Internal fee details for counseling reference only. Never shown on website."></textarea>
        </div>
        <div class="a-btns" style="margin-top:14px">
          <button class="a-btn a-btn-primary" data-act="click" data-do='[["addCollegeAdmin"]]'>➕ Add College to Supabase</button>
          <button class="a-btn a-btn-sec" data-act="click" data-do='[["loadAdminColleges"]]'>🔄 Refresh List</button>
        </div>
      </div>
      <div class="a-sect">
        <div class="a-label">Current Colleges in Supabase</div>
        <div id="admin-college-list"><p style="color:var(--muted);font-size:13px">Click Refresh to load colleges from Supabase.</p></div>
      </div>
    </div>

    <!-- SETTINGS -->
    <div class="a-pane" id="ap-settings">
      <div class="a-sect"><div class="a-label">Change Admin Password</div><div class="a-row"><input type="password" class="a-inp" id="a-new-pass" placeholder="New password (min 8 characters)"><input type="password" class="a-inp" id="a-conf-pass" placeholder="Confirm new password"></div><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["changePass"]]'>🔐 Change Password</button></div><p style="font-size:11px;color:var(--muted);margin-top:6px">Password stored in Supabase — works on all devices. Use a strong unique password.</p></div>
      <div class="a-sect"><div class="a-label">Calendly Booking URL</div><input type="text" class="a-inp" id="a-calendly" placeholder="https://calendly.com/..."><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveCalendly"]]'>💾 Save</button></div></div>
      <div class="a-sect"><div class="a-label">Google Analytics 4 — Measurement ID (Optional)</div><input class="a-inp" id="a-ga-code" type="text" placeholder="G-XXXXXXXXXX" autocomplete="off" spellcheck="false" style="font-family:monospace"><div style="font-size:11px;opacity:.7;margin-top:6px">Paste only the Measurement ID from GA4 → Admin → Data streams. Do not paste the full gtag script.</div><div class="a-btns"><button class="a-btn a-btn-primary" data-act="click" data-do='[["saveGA"]]'>💾 Save & Apply</button></div></div>
      <div class="a-sect"><div class="a-label">Developer Info</div><div style="background:var(--off);border-radius:9px;padding:14px;font-size:12px;color:var(--muted);line-height:2"><div>Supabase Project: <strong>fpzgcijbryvddtpegcmm</strong></div><div>Tables: leads, admin_settings, site_videos, site_testimonials, site_faqs</div></div></div>
      <div class="a-sect"><div class="a-label">Session</div><div class="a-btns"><button class="a-btn a-btn-danger" data-act="click" data-do='[["closeAdmin"]]'>🚪 Logout Admin</button></div></div>
    </div>
  </div>
</div>
</div>
