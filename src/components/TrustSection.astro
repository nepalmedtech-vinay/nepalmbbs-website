---
// Lifted verbatim from the single-page build (Phase 2). Had zero motion of
// its own — a dead, static block directly under the hero's own motion —
// which is exactly the kind of gap that reads as "the site isn't dynamic"
// even when other sections are. `.m-rise` brings the whole block up on
// scroll entry; `.m-stagger` on the grid cascades the six badges in one
// after another via motion.css's --n-indexed animation-range, no JS timer.
---
<div class="trust-section m-rise" id="hp-proof">
  {/* Phase 5A: the same grid language the hero's own field uses, at a
      third of its opacity and masked to fade out entirely by ~78% down
      this section — the cinematic atmosphere from Hero/Map settling into
      this section's editorial register rather than the two simply
      sitting next to each other. Styled in premium.css §22
      (.trust-field), matching where .gh-field itself is styled. */}
  <div class="trust-field" aria-hidden="true"></div>
<div class="trust-in">
  <div class="trust-title">Verified & Trusted Sources — Official Government Bodies Only</div>
  <div class="trust-grid m-stagger">
    <a href="https://nmc.org.in" target="_blank" rel="noopener" class="trust-badge" style="--n:0">
      <div class="trust-badge-icon"><svg width="26" height="26" viewBox="0 0 36 36"><circle cx="18" cy="18" r="18" fill="#FF9933"/><circle cx="18" cy="18" r="12" fill="#fff"/><circle cx="18" cy="18" r="12" fill="none" stroke="#138808" stroke-width="2"/><circle cx="18" cy="18" r="4" fill="#000080"/></svg></div>
      <div class="trust-badge-name">NMC India</div>
    </a>
    <a href="https://mec.gov.np" target="_blank" rel="noopener" class="trust-badge" style="--n:1">
      <div class="trust-badge-icon"><svg width="26" height="26" viewBox="0 0 36 36"><rect width="36" height="36" rx="4" fill="#003580"/><path d="M18 8l2.5 7.5H28l-6.5 4.5 2.5 7.5L18 23l-6 4.5 2.5-7.5L8 15.5h7.5z" fill="#fff"/></svg></div>
      <div class="trust-badge-name">MEC Nepal</div>
    </a>
    <a href="https://nmc.org.np" target="_blank" rel="noopener" class="trust-badge" style="--n:2">
      <div class="trust-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#5eead4" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg></div>
      <div class="trust-badge-name">Nepal NMC</div>
    </a>
    <a href="https://natboard.edu.in" target="_blank" rel="noopener" class="trust-badge" style="--n:3">
      <div class="trust-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#93c5fd" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg></div>
      <div class="trust-badge-name">NBE India</div>
    </a>
    <a href="https://wdoms.org" target="_blank" rel="noopener" class="trust-badge" style="--n:4">
      <div class="trust-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#86efac" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg></div>
      <div class="trust-badge-name">WDOMS</div>
    </a>
    <a href="https://entrance.mec.gov.np" target="_blank" rel="noopener" class="trust-badge" style="--n:5">
      <div class="trust-badge-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fcd34d" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
      <div class="trust-badge-name">MECEE Portal</div>
    </a>
  </div>
</div>
</div>
