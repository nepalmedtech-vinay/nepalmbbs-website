---
import { getColleges } from '../lib/colleges.js';
import places from '../data/places.json';

// Twenty-seven colleges plotted where they actually are.
//
// This is the site's one signature graphic, and it is built from the real
// records rather than bought in: positions come from the towns in
// colleges.json, sized by the seats each college actually offers. It is
// deliberately not a survey map — no borders are drawn and none are claimed.
// It is a relative-position field, which is honest about its precision while
// still telling a family, at a glance, that the east has clusters and the
// far west has almost nothing.
//
// Phase 5D: reused as-is on college detail pages via three additive props —
// nothing below changes for the homepage/`/colleges` callers, which pass
// none of them. `highlight` marks one college's point as already-active (the
// same `.is-active` state hover/focus already produce, not a new visual);
// `variant="compact"` swaps the wide homepage layout for a narrower one that
// sits beside a page's own copy; `headOverride` replaces the generic
// headline with page-specific copy. A college whose `location` has no entry
// in places.json (one currently does not — see TECHNICAL_DEBT.md) simply
// won't appear as a point and can't be highlighted; callers check for that
// via the exported `hasCoords` behaviour (a college not in `points`).
interface Props {
  highlight?: string;
  variant?: 'full' | 'compact';
  headOverride?: { eyebrow: string; title: string; lead: string };
  sectionId?: string;
}
const { highlight, variant = 'full', headOverride, sectionId = 'hp-place' } = Astro.props;
const compact = variant === 'compact';

const colleges = (await getColleges()).filter((c) => places[c.location]);

// Nepal's extent, padded. Latitude is inverted because SVG y grows downward.
const LON = [80.0, 88.35];
const LAT = [26.15, 29.75];
const W = 1000;
const H = 420;
const PAD = 46;

const x = (lon) => PAD + ((lon - LON[0]) / (LON[1] - LON[0])) * (W - PAD * 2);
const y = (lat) => PAD + (1 - (lat - LAT[0]) / (LAT[1] - LAT[0])) * (H - PAD * 2);

const maxSeats = Math.max(...colleges.map((c) => parseInt(c.seats, 10) || 1));

const points = colleges
  .map((c) => {
    const p = places[c.location];
    const seats = parseInt(c.seats, 10) || 0;
    return {
      ...c,
      seats,
      cx: x(p.lon),
      cy: y(p.lat),
      // Area-proportional, not radius-proportional: sizing by radius would
      // make a 65-seat college look seven times a 9-seat one.
      r: 4 + Math.sqrt(seats / maxSeats) * 11,
      govt: c.type === 'govt',
    };
  })
  .sort((a, b) => b.r - a.r);

// Sum over `points`, not `colleges`: seats arrive from JSON as strings, so
// reducing the raw records concatenates them into a 45-digit number instead of
// adding them. `points` has already been through parseInt.
const totalSeats = points.reduce((n, p) => n + p.seats, 0);
---

<section class:list={['map-section', { 'map-section--compact': compact }]} id={sectionId}>
  {/* Cinematic pass: the hero and Trust each carry their own atmospheric
      field (.gh-field / .trust-field, brand-tinted); Place — this section
      — was the one full-width chapter with none, reading as a flat drop
      after Promise's blue glow. Teal (--brand-2) rather than repeating
      the hero's blue, so the five-chapter homepage reads as a deliberate
      tonal journey rather than one colour repeated five times. Skipped
      entirely for the compact college-detail reuse — that's a supporting
      panel beside a page's own copy, not a chapter of its own. */}
  {!compact && <div class="map-field m-para-shift" style="--m-depth: 26px" aria-hidden="true"></div>}
  <div class:list={['container', { 'map-in--compact': compact }]}>

    {/* Phase 5A: .m-focus (motion.css) instead of the generic .m-rise the
        rest of the site's block-arrivals use — a blur-in that reads as a
        camera pulling focus rather than a plain fade, so this section
        feels like it's resolving out of the hero's own field instead of
        starting its own, unrelated entrance. Existing primitive, no new
        CSS. */}
    <div class="map-head m-focus">
      <span class="gl-eyebrow">{headOverride?.eyebrow ?? 'Where they are'}</span>
      {headOverride
        ? <h2 class="map-title">{headOverride.title}</h2>
        : (
          <h2 class="map-title">
            One admission process,<br />
            <span class="gl-grad">{colleges.length} places it can take you</span>
          </h2>
        )}
      <p class="gl-lead">
        {headOverride?.lead ?? (
          <>Every college is plotted where it actually sits, sized by the
          {' '}{totalSeats} foreign-quota seats between them. The clustering is not
          an accident of the drawing — it is where Nepal's medical education
          actually is, and it is worth knowing before you pick a city.</>
        )}
      </p>
    </div>

    <figure class="map-figure m-focus">
      {/* Cinematic pass: the site's one signature graphic gets the same
          pointer-tilt + specular treatment CollegeHero's photo pane already
          uses (glass.css's `.gl--live`, not the full `.gl` panel) — as one
          continuous physical surface reacting to the pointer, rather than
          27 small independent wobbling targets, which is why this reads as
          depth and the rejected comparison-picker treatment would not have.
          `.gl--live` sits on this inner wrapper rather than on `.map-figure`
          itself: `.m-focus`'s own scroll-driven entrance animation ends by
          setting `transform: none` with `fill: both`, and a CSS animation's
          value for a property always wins over a plain declaration on the
          same element — so the tilt would be permanently dead-on-arrival
          once the figure had scrolled past its entry range. Same split
          GlassHero.astro already uses for its stat cards (float animation
          and pointer-tilt on separate elements) so the two transforms don't
          fight. The readout card and legend stay outside this wrapper so
          hovering a point does not tilt the text panel that names it. */}
      <div class="map-tilt gl--live">
        <svg
          class="map-svg"
          class:list={[{ 'has-highlight': !!highlight }]}
          style="color:var(--brand)"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label={`Relative positions of ${colleges.length} medical colleges across Nepal`}
        >
          <defs>
            <radialGradient id="mapHalo">
              <stop offset="0" stop-color="currentColor" stop-opacity="0.34" />
              <stop offset="1" stop-color="currentColor" stop-opacity="0" />
            </radialGradient>
            <filter id="mapGlow" x="-70%" y="-70%" width="240%" height="240%">
              <feGaussianBlur stdDeviation="5" />
            </filter>
          </defs>

          <!-- Graticule. Real degree lines, labelled — the element that keeps
               this readable as a coordinate plot rather than a decorative blob. -->
          <g class="map-grid">
            {[82, 84, 86, 88].map((lon) => (
              <>
                <line pathLength="1" x1={x(lon)} y1={PAD - 14} x2={x(lon)} y2={H - PAD + 14} />
                <text x={x(lon)} y={H - PAD + 30} text-anchor="middle">{lon}°E</text>
              </>
            ))}
            {[27, 28, 29].map((lat) => (
              <>
                <line pathLength="1" x1={PAD - 14} y1={y(lat)} x2={W - PAD + 14} y2={y(lat)} />
                <text x={PAD - 20} y={y(lat) + 4} text-anchor="end">{lat}°N</text>
              </>
            ))}
          </g>

          <g class="map-points">
            {points.map((p, i) => (
              <g
                class:list={['map-pt', { 'is-govt': p.govt, 'is-highlight': p.slug === highlight }]}
                style={`--i:${i}`}
                data-name={p.name}
                data-loc={p.location}
                data-seats={p.seats}
                data-href={`/colleges/${p.slug}`}
                tabindex="0"
                role="link"
                aria-label={`${p.name}, ${p.location}, ${p.seats} seats`}
              >
                <circle class="map-halo" cx={p.cx} cy={p.cy} r={p.r * 2.6} fill="url(#mapHalo)" filter="url(#mapGlow)" />
                <circle class="map-ping" cx={p.cx} cy={p.cy} r={p.r} />
                <circle class="map-ring" cx={p.cx} cy={p.cy} r={p.r} />
                <circle class="map-dot"  cx={p.cx} cy={p.cy} r={Math.max(2, p.r * 0.34)} />
                <circle class="map-hit"  cx={p.cx} cy={p.cy} r={Math.max(p.r + 12, 18)} />
              </g>
            ))}
          </g>
        </svg>
      </div>

      <div class="map-card" id="map-card" aria-live="polite" hidden>
        <p class="map-card-name"></p>
        <p class="map-card-meta"></p>
        <span class="map-card-cta">View record →</span>
      </div>

      <figcaption class="map-legend">
        <span class="map-key is-govt"><i></i>Government</span>
        <span class="map-key"><i></i>Private</span>
        <span class="map-key map-key--scale"><i></i>Circle area = foreign-quota seats</span>
      </figcaption>
    </figure>

  </div>
</section>

<script is:inline>
  (function () {
    var fig = document.querySelector('.map-figure');
    if (!fig) return;
    var card = document.getElementById('map-card');
    var name = card.querySelector('.map-card-name');
    var meta = card.querySelector('.map-card-meta');
    var active = null;

    function show(g) {
      if (active) active.classList.remove('is-active');
      active = g;
      g.classList.add('is-active');
      name.textContent = g.dataset.name;
      meta.textContent = g.dataset.loc + ' · ' + g.dataset.seats + ' seats';
      card.hidden = false;
      // Position against the figure, clamped so a point near an edge does not
      // push the card outside it.
      var c = g.querySelector('.map-ring').getBoundingClientRect();
      var f = fig.getBoundingClientRect();
      var left = c.left - f.left + c.width / 2;
      card.style.left = Math.min(Math.max(left, 90), f.width - 90) + 'px';
      card.style.top = c.top - f.top - 14 + 'px';
    }

    function hide() {
      if (active) active.classList.remove('is-active');
      active = null;
      card.hidden = true;
    }

    fig.querySelectorAll('.map-pt').forEach(function (g) {
      g.addEventListener('pointerenter', function () { show(g); });
      g.addEventListener('focus', function () { show(g); });
      g.addEventListener('click', function () { location.href = g.dataset.href; });
      g.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); location.href = g.dataset.href; }
      });
    });
    fig.addEventListener('pointerleave', hide);
    fig.addEventListener('focusout', function (e) {
      if (!fig.contains(e.relatedTarget)) hide();
    });

    // Phase 5D: on a college detail page, one point already carries a
    // server-rendered .is-highlight (a permanent mark, untouched by
    // show()/hide() above) — reveal its readout card once, right after the
    // points draw in, so the map opens already answering "where is this
    // one" rather than waiting for a hover that a visitor has no reason to
    // try. Hovering elsewhere still works exactly as before; the highlight
    // ring itself never depends on `active`, so it survives regardless.
    //
    // show() reads layout (getBoundingClientRect on both the point and the
    // figure) to position the card — real work, and measured to add ~90ms
    // of blocking time when it runs synchronously inside the
    // IntersectionObserver callback, right as the rest of the page is
    // still settling. Deferred one frame past paint with requestAnimationFrame
    // (a setTimeout(…, 0) fallback for the handful of browsers without it)
    // so this purely-cosmetic reveal never competes with first paint for
    // main-thread time; a visitor sees the card appear a frame later, which
    // reads as instant either way.
    function revealHighlight() {
      var reveal = function () {
        var hl = fig.querySelector('.map-pt.is-highlight');
        if (hl) show(hl);
      };
      if (window.requestAnimationFrame) requestAnimationFrame(function () { requestAnimationFrame(reveal); });
      else setTimeout(reveal, 0);
    }

    // Draw the points in only once the figure is actually on screen.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) { fig.classList.add('is-drawn'); revealHighlight(); io.disconnect(); }
        });
      }, { threshold: 0.18 });
      io.observe(fig);
    } else {
      fig.classList.add('is-drawn');
      revealHighlight();
    }
  })();
</script>

<style>
  /* Phase 5D reuse: dims every point except the one this page is about, and
     gives that one a permanent ring independent of hover/focus state (the
     existing .is-active class is transient — show()/hide() below move it
     between whichever point the pointer is over). Only active when a
     `highlight` prop is passed; homepage/`/colleges` never set one, so
     `.map-svg` never gets `.has-highlight` there and this is a no-op. */
  .map-svg.has-highlight .map-pt:not(.is-highlight) .map-ring,
  .map-svg.has-highlight .map-pt:not(.is-highlight) .map-dot {
    opacity: 0.32;
  }
  .map-pt.is-highlight .map-ring {
    fill: color-mix(in oklab, var(--brand) 22%, transparent);
    stroke: var(--brand-lift);
    stroke-width: 2;
  }
  .map-pt.is-highlight .map-dot { fill: var(--brand-lift); }
  .map-pt.is-highlight .map-halo { opacity: 1; }

  /* Compact variant: a college detail page reuses this component beside its
     own copy rather than as a full-width section, so the wide single-column
     homepage layout becomes a narrower two-column one at desktop widths,
     with shorter vertical padding. Below that width it stacks exactly like
     the homepage's own responsive behaviour — no separate mobile rules
     needed here. */
  .map-section--compact { padding: var(--s-6, 2.5rem) 0; }
  @media (min-width: 62rem) {
    .map-in--compact {
      display: grid;
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 3.5rem);
      align-items: start;
    }
    .map-in--compact .map-head { max-width: none; }
    .map-in--compact .map-figure { margin-top: 0; }
  }
</style>
