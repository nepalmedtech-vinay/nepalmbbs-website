---
import { getColleges } from '../lib/colleges.js';

// Replaces HeroPremium, which was written against premium.css — a layer the
// glass build no longer loads, so its .pm-* classes had no rules at all and
// the home page was rendering unstyled text on unstyled panes.
const colleges = await getColleges();
const seats = colleges.reduce((n, c) => n + (parseInt(c.seats, 10) || 0), 0);
const govt = colleges.filter((c) => c.type === 'govt').length;

// Counted from the records, so the hero cannot drift out of step with the
// pages behind it.
const stats = [
  { n: colleges.length, l: 'colleges admitting Indian students' },
  { n: seats,           l: 'foreign-quota seats' },
  { n: govt,            l: 'government institutions' },
];
---
<section class="gh">
  {/* The field: architectural grid + one slow radial light + a graticule
      motif borrowed from the map section below (same fine-line, degree-
      tick language) + a handful of drifting marks previewing the map's
      dots. Entirely decorative, aria-hidden, and — per the brief's own
      instruction — the motion here is meant to register subconsciously,
      not be watched: one very slow (26s+) drift, nothing that resolves
      into a shape someone would try to read. */}
  <div class="gh-field" aria-hidden="true">
    <div class="gh-grid"></div>
    <div class="gh-glow"></div>
    <svg class="gh-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
      <line x1="0" y1="28" x2="100" y2="28" />
      <line x1="0" y1="74" x2="100" y2="74" />
      <line x1="82" y1="0" x2="82" y2="100" />
    </svg>
    <span class="gh-mark" style="--mx:12%; --my:22%; --md:34s"></span>
    <span class="gh-mark" style="--mx:88%; --my:64%; --md:41s"></span>
    <span class="gh-mark" style="--mx:74%; --my:18%; --md:29s"></span>
  </div>

  <div class="wrap gh-in">
   <div class="gh-copy">
    <span class="gl-eyebrow gh-in-1">NMC India recognised · MEC Nepal process</span>

    <h1 class="gl-display gh-h1">
      <span class="gl-line" style="--i:1"><span>Your MBBS in Nepal,</span></span>
      <span class="gl-line" style="--i:2"><span>decided on <em class="gl-grad">evidence</em>.</span></span>
    </h1>

    <p class="gl-lead gh-in-4">
      We publish what we can source and say so when we cannot. No fee figures
      that go stale, no stock photographs standing in for a campus, no promise
      the Medical Education Commission has not made.
    </p>

    <div class="gh-cta gh-in-5">
      <a href="/counseling" class="gl-crystal m-magnet" data-pull="0.22">
        <span class="gl-crystal-face"><span class="gl-crystal-sheen"></span>Book free counseling</span>
      </a>
      <a href="/colleges" class="gl-btn gl-btn--ghost">See all {colleges.length} colleges</a>
    </div>
   </div>

    {/* The ledger. Below 76rem it is the row of three figures it has always
        been; above it, it moves alongside the headline as a stacked column of
        rules — which is what the empty right-hand third of a 1440px screen
        was for, and it is filled with counted evidence rather than with a
        stock photograph the site has said it will not use. */}
    <dl class="gh-stats gh-in-6">
      {stats.map((s) => (
        <div class="gh-stat">
          <dt><b data-count={s.n}>0</b></dt>
          <dd>{s.l}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style is:global>
  .gh { padding-block: clamp(3rem, 1.5rem + 7vw, 7rem) var(--s-section); }
  .gh-in { max-width: 62rem; }
  .gh-copy { min-width: 0; }

  @media (min-width: 76rem) {
    .gh-in {
      max-width: min(var(--container), 100%);
      display: grid;
      grid-template-columns: minmax(0, 1fr) 17rem;
      column-gap: clamp(2.5rem, 1rem + 4vw, 5.5rem);
      align-items: start;
    }
    .gh-stats {
      grid-template-columns: minmax(0, 1fr) !important;
      margin-top: var(--s-3) !important;
      border-top: 0 !important;
    }
  }
  .gh-h1 { margin: var(--s-5) 0 var(--s-5); }
  .gh-h1 em { font-style: italic; }
  .gh-cta { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-6); }

  .gh-stats {
    display: grid; gap: var(--s-4); margin-top: var(--s-8);
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }
  .gh-stat { padding: var(--s-5); margin: 0; }
  .gh-stat dt, .gh-stat dd { margin: 0; }
  .gh-stat b {
    display: block; font-family: var(--ty-display);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 2.9rem); font-weight: var(--ty-weight-d);
    line-height: 1; letter-spacing: var(--ty-tight);
    font-variant-numeric: tabular-nums; color: var(--g-ink);
  }
  .gh-stat dd {
    display: block; margin-top: var(--s-2);
    font-size: var(--t-xs); color: var(--g-ink-3);
  }
</style>
