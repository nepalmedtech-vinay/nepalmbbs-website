---
// Lifted verbatim from the single-page build (Phase 2).
---
<div class="chat-wrap" id="chat-wrap">
  <div class="chat-window" id="chat-window">
    <div class="chat-header" id="chat-header">
      {/* "Official info • Instant answers" overstated it — the assistant
          answers from a reviewed dataset, and part of what it does is decline
          when a question falls outside that. The subtitle now says what it
          actually is. */}
      <div class="chat-header-left">
        <div class="chat-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/></svg>
        </div>
        <div><h4>Admissions Assistant</h4><p>Answers from sourced records</p></div>
      </div>
      <div class="chat-header-right">
        <span class="swipe-label">↑ swipe to close</span>
        <button class="chat-close-btn" data-act="click" data-do='[["closeChat"]]' aria-label="Close chat">×</button>
      </div>
    </div>
    <div class="chat-msgs" id="chat-msgs">
      <div class="chat-msg bot">Ask about eligibility, the admission process, recognition, or any of the 27 colleges. Every answer names the source it came from, and I will tell you when I do not have one.</div>
    </div>
    {/* One chip now names a college, because the assistant can answer from the
        college records themselves — that capability is invisible unless a
        visitor happens to try it. */}
    <div class="chat-suggestions" id="chat-sugs">
      <span class="chat-sug" data-act="click" data-do='[["askBot","Is NEET required for MBBS in Nepal?"]]'>NEET required?</span>
      <span class="chat-sug" data-act="click" data-do='[["askBot","What NEET percentile is required?"]]'>Percentile?</span>
      <span class="chat-sug" data-act="click" data-do='[["askBot","How many seats does Nobel Medical College have?"]]'>Ask about a college</span>
      <span class="chat-sug" data-act="click" data-do='[["askBot","How does admission through MEC Nepal work?"]]'>Admission process</span>
      <span class="chat-sug" data-act="click" data-do='[["askBot","Will the degree let me practise in India?"]]'>Practising in India</span>
      <span class="chat-sug" data-act="click" data-do='[["askBot","How do I verify a college is recognised?"]]'>Verify a college</span>
    </div>
    <div class="chat-restart-btn" data-act="click" data-do='[["restartChat"]]'>🔄 Start New Chat</div>
    <div class="chat-input-area">
      <input class="chat-input" id="chat-input" placeholder="Ask anything..." data-act="enter" data-do='[["sendMsg"]]'>
      <button class="chat-send" data-act="click" data-do='[["sendMsg"]]' aria-label="Send"><svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg></button>
    </div>
  </div>
  <div class="chat-toggle" data-act="click" data-do='[["toggleChat"]]' aria-label="Open chat">
    <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg>
  </div>
</div>

<!-- SUPABASE SETUP HINT (admin only) -->
