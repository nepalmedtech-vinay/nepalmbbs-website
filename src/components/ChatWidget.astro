  - leads (id, student_name, contact_number, neet_score, city, stage, notes, created_at)
  - site_videos (id, title, url, description, college_slug, is_active, sort_order, created_at)
  - site_testimonials (id, name, city, year, stars, quote, is_active, sort_order, created_at)
  - site_faqs (id, question, answer, category, sort_order, is_active, created_at)
  - admin_settings (key, value, updated_at)
  - site_colleges (id, name, location, foreign_seats, college_type, website, established, fee_notes_internal, is_active, sort_order, created_at)
  Enable RLS on all tables. Admin operations go through service role key set in Supabase config.
-->
