---
// The nine section cards from the single-page build. They were <div>s calling
// switchTab(); they are now real links, which is the whole point of Phase 2 —
// a crawler could not follow an onclick, and a user could not bookmark one.
// Classes and SVGs are unchanged so the styling carries over untouched.
---
<div class="tabs-section" id="tabs-section">
<div class="tabs-container">
  <div class="tabs-label">Navigate Sections</div>
  <div class="tabs-grid">
    <a href="/admission-process" class="tab-card" id="tab-process"><svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg><div class="tab-label" data-en="Admission<br>Process" data-hi="प्रवेश<br>प्रक्रिया">Admission<br>Process</div></a>
    <a href="/colleges" class="tab-card" id="tab-colleges"><svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l9-6 9 6v12"/><path d="M9 21V12h6v9"/><path d="M12 3v3"/><circle cx="12" cy="9" r="1" fill="currentColor"/></svg><div class="tab-label" data-en="Nepal Medical<br>Colleges" data-hi="नेपाल मेडिकल<br>कॉलेज">Nepal Medical<br>Colleges</div></a>
