---
import { getColleges } from '../lib/colleges.js';

// The hero this replaces cycled 51 background slides, 37 distinct Unsplash
// photographs, all fetched before window 'load' fired. The whole backdrop is
// now one 18 KB generated vector — sharper on every screen than a JPEG, and
// it costs one request instead of fifty-five.
const colleges = await getColleges();
const seats = colleges.reduce((n, c) => n + (parseInt(c.seats, 10) || 0), 0);
const govt = colleges.filter((c) => c.type === 'govt').length;

// Every figure below is counted from the records, not written by hand, so the
// hero cannot drift out of step with the pages behind it.
const stats = [
  { n: colleges.length, label: 'colleges admitting Indian students' },
  { n: seats,           label: 'foreign-quota seats' },
  { n: govt,            label: 'government institutions' },
];

const headline = [
  { text: 'Your MBBS in Nepal,' },
  { text: 'decided on', accent: 'evidence.' },
];
---

<section class="hero-pm">
  <div class="hero-pm-bg" aria-hidden="true">
    <img src="/assets/gfx/ridges.svg" alt="" width="2400" height="900" fetchpriority="high" />
    <div class="hero-pm-veil"></div>
  </div>
  <div class="pm-ambient" aria-hidden="true"></div>

  <div class="container hero-pm-in">
    <span class="pm-eyebrow">NMC India recognised · MEC Nepal process</span>

    <h1 class="pm-display hero-pm-h1">
      {headline.map((l, i) => (
        <span class="pm-line" style={`--pm-line-i:${i}`}>
          <span>{l.text}{l.accent && <> <em class="pm-accent">{l.accent}</em></>}</span>
        </span>
      ))}
    </h1>

    <p class="pm-lead">
      We publish what we can source and say so when we cannot. No fee figures
      that go stale, no stock photographs standing in for a campus, no promise
      the Medical Education Commission has not made.
    </p>

    <div class="hero-pm-cta">
      <a href="/counseling" class="pm-btn pm-btn--primary">Book free counseling</a>
      <a href="/colleges" class="pm-btn pm-btn--ghost">See all {colleges.length} colleges</a>
    </div>

    <div class="pm-stats">
      {stats.map((s) => (
        <div>
          <span class="pm-stat-n" data-count={s.n}>0</span>
          <span class="pm-stat-l">{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-pm-scroll" aria-hidden="true"><span></span></div>
</section>

<script is:inline>
  (function () {
    // Count the stats up once, when they are actually on screen. Counting on
    // load would animate numbers nobody is looking at, and re-counting on every
    // scroll past would read as a glitch.
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var els = document.querySelectorAll('.pm-stat-n[data-count]');
    if (!els.length) return;

    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach(function (el) { el.textContent = el.dataset.count; });
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        var el = e.target;
        var to = parseInt(el.dataset.count, 10) || 0;
        var start = 0;
        var dur = 1100;
        (function tick(t) {
          if (!start) start = t;
          var p = Math.min((t - start) / dur, 1);
          // Ease out: the number should decelerate into its final value rather
          // than snap, or the last digits look like a stutter.
          el.textContent = Math.round(to * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(tick);
        })(performance.now());
      });
    }, { threshold: 0.4 });

    els.forEach(function (el) { io.observe(el); });
  })();
</script>
