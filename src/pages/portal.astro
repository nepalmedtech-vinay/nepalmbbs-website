---
import GlassLayout from '../layouts/GlassLayout.astro';
---
<GlassLayout
  title="Your Application — NepalMBBS.in"
  description="Track the status of your MBBS Nepal application."
  path="/portal"
  bare={true}
>
<link rel="stylesheet" href="/assets/css/console.css">
<meta name="robots" content="noindex, nofollow">

<main class="cx">
  <div class="cx-head">
    <div class="cx-title">
      <a href="/" class="gl-eyebrow" style="text-decoration:none">NepalMBBS.in</a>
      <h1 id="p-name">Your application</h1>
      <p id="p-intake"></p>
    </div>
    <div class="cx-actions">
      <span id="p-stage" class="st st-enquiry">—</span>
      <button id="p-signout" type="button" class="gl-btn gl-btn--quiet">Forget this link</button>
    </div>
  </div>

  <!-- No token yet, or a bad one. -->
  <section id="p-gate" class="gl cx-card" hidden style="max-width:520px;margin-inline:auto">
    <h3>Open your application</h3>
    <p class="cx-sub">Paste the private link your counselor sent you. It works without a password, so please do not forward it to anyone.</p>
    <div id="p-gate-err" class="cx-error" hidden style="margin-bottom:14px"></div>
    <form id="p-gate-form">
      <div class="cx-field">
        <label for="p-gate-input">Your link or code</label>
        <input id="p-gate-input" class="cx-input" type="text" autocomplete="off"
               spellcheck="false" placeholder="https://nepalmbbs.in/portal?t=…">
      </div>
      <button type="submit" class="gl-btn gl-btn--primary" style="width:100%">Open</button>
    </form>
    <p class="cx-sub" style="margin:16px 0 0">
      Lost the link? <a href="https://wa.me/917080800888" target="_blank" rel="noopener">Message us on WhatsApp</a> and we will send a new one.
    </p>
  </section>

  <div id="p-loading" hidden>
    <div class="cx-grid">
      <div class="cx-skel"></div><div class="cx-skel"></div><div class="cx-skel"></div>
    </div>
  </div>

  <div id="p-app" hidden>
    <div id="p-college" class="cx-note" hidden style="margin-bottom:18px">
      <strong>Seat allotted:</strong> <span id="p-college-name"></span>
    </div>

    <div class="cx-grid" style="grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)">
      <section class="gl cx-card">
        <h3>Where your application stands</h3>
        <p class="cx-sub">Each step is updated by your counselor as it happens.</p>
        <div id="p-updates-head" class="cx-divider" hidden>Latest updates</div>
        <ul id="p-updates" class="cx-tl cx-tl--updates" hidden></ul>
        <div id="p-steps-head" class="cx-divider">Every step</div>
        <ul id="p-timeline" class="cx-tl"></ul>
      </section>

      <section class="gl cx-card">
        <h3>Documents</h3>
        <p class="cx-sub" id="p-doc-summary"></p>
        <div id="p-docs" class="cx-docs"></div>
        <div class="cx-note" style="margin-top:16px">
          Send documents to your counselor on <a href="https://wa.me/917080800888" target="_blank" rel="noopener">WhatsApp</a> or <a href="mailto:info@nepalmbbs.in">info@nepalmbbs.in</a>. Never pay anyone for a seat — fees go directly to the college.
        </div>
      </section>
    </div>
  </div>
</main>

<script is:inline src="/assets/js/portal.js"></script>
</GlassLayout>
