---
import GlassLayout from '../layouts/GlassLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---
<GlassLayout
  title="NEET Score Eligibility Calculator for MBBS in Nepal | NepalMBBS.in"
  description="Check whether your NEET score qualifies you for MBBS admission in Nepal. Instant eligibility result based on official MEC Nepal and NMC India criteria."
  path="/neet-calculator"
>
<div class="tab-pane on" id="pane-calculator">
<div class="container">
  <PageHeader eyebrow="Free Tool" center lead="Checked against the published NMC India and MEC Nepal eligibility rules — not a seat guarantee.">NEET Eligibility Checker</PageHeader>
  <div class="calc-wrap rev">
    <h3>Check Your Eligibility</h3>
    <p>Your NEET percentile is on your official NTA scorecard — it's not the same as your raw score, which can't be checked against a fixed number since the qualifying mark is reset every year.</p>
    <div class="calc-grid">
      <div class="cfield"><label for="calc-percentile">NEET Percentile</label><input type="number" id="calc-percentile" placeholder="e.g. 62.5" min="0" max="100" step="0.01" inputmode="decimal"></div>
      <div class="cfield"><label for="calc-cat">Category</label><select id="calc-cat"><option value="gen">General</option><option value="obc">OBC</option><option value="sc">SC/ST</option></select></div>
      <div class="cfield"><label for="calc-pcb">12th PCB Aggregate</label><select id="calc-pcb"><option value="">Select</option><option>90%+</option><option>80-89%</option><option>70-79%</option><option>60-69%</option><option>50-59%</option><option>Below 50%</option></select></div>
    </div>
    <button class="calc-btn" data-act="click" data-do='[["checkEligibility"]]'>Check My Eligibility →</button>
    <div class="calc-result" id="calc-result"></div>
    <div class="calc-dis">This checks your NEET percentile and 12th PCB aggregate against the regulatory thresholds below. It is NOT official admission advice and does not check seat availability. Always verify at <a href="https://nmc.org.in" target="_blank">nmc.org.in</a> and <a href="https://mec.gov.np" target="_blank">mec.gov.np</a> before making any decision.</div>
  </div>
</div>
</div>
</GlassLayout>
