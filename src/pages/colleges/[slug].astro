---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getColleges } from '../../lib/colleges.js';
import { SITE } from '../../lib/routes.js';

export async function getStaticPaths() {
  const colleges = await getColleges();
  return colleges.map((college) => ({
    params: { slug: college.slug },
    props: { college },
  }));
}

const { college: c } = Astro.props;
const isGovt = c.type === 'govt';
const path = `/colleges/${c.slug}`;

// Every field below comes from the site's own existing data. Nothing here is
// inferred, rounded or filled in: an admissions page that invents a fee or a
// ranking is worse than one that says "contact us", because a family will act
// on it. Where a value is missing it is shown as missing.
const facts = [
  ['Ownership',        c.badge || (isGovt ? 'Government' : 'Private')],
  ['Location',         c.location],
  ['Affiliation',      c.affiliation],
  ['Established',      c.established],
  ['Foreign-quota seats', c.seats],
  ['Course duration',  c.duration || '5.5 Years (including internship)'],
  ['Admission route',  c.admission || 'NEET qualified, via MEC Nepal'],
].filter(([, v]) => v);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollegeOrUniversity',
  name: c.name,
  url: `${SITE}${path}`,
  ...(c.website ? { sameAs: [c.website] } : {}),
  ...(c.location ? { address: { '@type': 'PostalAddress', addressLocality: c.location, addressCountry: 'NP' } } : {}),
  ...(c.affiliation ? { parentOrganization: { '@type': 'EducationalOrganization', name: c.affiliation } } : {}),
};
---
<BaseLayout
  title={`${c.name} — MBBS Admission, Seats & Fees 2025 | NepalMBBS.in`}
  description={`${c.name}${c.location ? `, ${c.location}` : ''}: MBBS admission for Indian students${c.seats ? `, ${c.seats} foreign-quota seats` : ''}${c.affiliation ? `, affiliated to ${c.affiliation}` : ''}. Admission through MEC Nepal.`}
  path={path}
  schema={schema}
>
<div class="tab-pane on">
<div class="container">

  <div class="rev" style="margin-bottom:8px">
    <a href="/colleges" class="college-link" style="display:inline-block;margin-bottom:18px">← All Nepal medical colleges</a>
    <div class="eyebrow">{isGovt ? 'Government college' : 'Private college'} · MEC Nepal 2025-26</div>
    <h1 class="sec-title" style="margin-bottom:10px">{c.name}</h1>
    <div class="sec-sub">
      {[c.location, c.affiliation].filter(Boolean).join(' · ')}
    </div>
  </div>

  <div class="college-card rev" style="margin-top:28px">
    <div class="college-details" style="grid-template-columns:1fr">
      {facts.map(([label, value]) => (
        <div class="college-stat">
          <span class="cs-label">{label}</span>
          <span class="cs-val">{value}</span>
        </div>
      ))}
      <div class="college-stat">
        <span class="cs-label">Tuition fee</span>
        <span class="cs-val" style="color:var(--accent);font-weight:700">
          <a href="/counseling" style="color:inherit;text-decoration:none">Ask us for the current structure →</a>
        </span>
      </div>
    </div>
    <div class="college-footer">
      {c.website && (
        <a href={c.website} target="_blank" rel="noopener" class="college-link">Official website ↗</a>
      )}
      <button class="college-enquire" onclick={`enquireCollege('${(c.enquiryName || c.name).replace(/'/g, "\\'")}')`}>
        Enquire about {c.name.split('(')[0].trim()}
      </button>
    </div>
  </div>

  <div class="rev" style="margin-top:32px">
    <div class="sec-sub" style="max-width:66ch">
      Fees and seat allocation for {c.name} are set each intake by MEC Nepal and the
      college, so we do not publish a figure that may be out of date by the time you
      read it. We will give you the current structure, in writing, on a call.
    </div>
    <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap">
      <a href="/counseling" class="btn-primary">Book free counseling →</a>
      <a href="/admission-process" class="college-link" style="align-self:center">How the MEC process works</a>
    </div>
  </div>

</div>
</div>
</BaseLayout>
