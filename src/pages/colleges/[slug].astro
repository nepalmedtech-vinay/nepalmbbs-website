---
import GlassLayout from '../../layouts/GlassLayout.astro';
import CollegeHero from '../../components/CollegeHero.astro';
import CollegeMap from '../../components/CollegeMap.astro';
import { getColleges } from '../../lib/colleges.js';
import { SITE } from '../../lib/routes.js';
import knowledge from '../../data/knowledge.json';
import places from '../../data/places.json';
import videoCategories from '../../data/video-categories.json';

// One review date for the whole dataset, taken from the same file the
// assistant answers from, so a page and an answer cannot claim different
// freshness for the same record.
const REVIEWED = knowledge.reviewed;
const topic = (id) => knowledge.topics.find((t) => t.id === id);

export async function getStaticPaths() {
  const colleges = await getColleges();
  return colleges.map((college) => ({
    params: { slug: college.slug },
    props: { college },
  }));
}

const { college: c } = Astro.props;
const isGovt = c.type === 'govt';
const path = `/colleges/${c.slug}`;
const shortName = c.name.split('(')[0].trim();
const hasCoord = !!places[c.location];
const videoCategory = videoCategories[c.slug]?.code || '';
// Computed once here (frontmatter can await; the template below cannot) —
// how many of the 27 colleges the compact map actually plots, for its own
// lead copy.
const plottedCount = (await getColleges()).filter((x) => places[x.location]).length;

// Every row comes from the site's own data. Nothing is inferred, rounded or
// filled in — an admissions page that invents a fee or a ranking is worse than
// one that says it does not know, because a family will act on it. Where a
// value is missing, the row stays and says so, so it can be asked about.
const record = [
  ['Ownership',           c.badge || (isGovt ? 'Government' : 'Private')],
  ['Location',            c.location],
  ['University affiliation', c.affiliation],
  ['Established',         c.established],
  ['Foreign-quota seats', c.seats],
  ['Course duration',     c.duration || '5.5 years, including internship'],
  ['Admission route',     c.admission || 'NEET qualified, through MEC Nepal'],
];

// Phase 5D — "your years here": the same four-stage academic path is true of
// every MEC-approved college (it is set by Nepal Medical Council / NMC India
// regulation, not by the individual institution), so this is not a per-
// college fact invented for this page — it is knowledge.json's own already-
// sourced topics, read in chronological order instead of as separate FAQ
// answers. The one truly per-college fact — whether this college's own name
// names its teaching hospital — is added to step 2 only when it's actually
// there to read.
const hospitalInName = /teaching hospital/i.test(c.name);
// Paraphrased directly from knowledge.json's own already-sourced answers
// (each `source` below is that same topic's own citation) rather than
// derived by slicing their prose — the four-stage structure is regulation,
// true of every MEC-approved college, not a fact invented for this one.
const academicSteps = [
  {
    title: 'Pre-clinical years',
    body: 'Anatomy, Physiology and Biochemistry — the same pre-clinical sequence the Indian MBBS curriculum follows.',
    source: topic('curriculum').source,
  },
  {
    title: 'Clinical years',
    body: `Medicine, Surgery, Obstetrics & Gynaecology and Paediatrics. ${topic('teaching-hospital').answer}`,
    source: topic('teaching-hospital').source,
  },
  {
    title: 'Internship in Nepal',
    body: `${topic('duration').answer} ${topic('provisional-registration').answer}`,
    source: topic('duration').source,
  },
  {
    title: 'NMC screening, in India',
    body: topic('next-fmge').answer,
    source: topic('next-fmge').source,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollegeOrUniversity',
  name: c.name,
  url: `${SITE}${path}`,
  ...(c.website ? { sameAs: [c.website] } : {}),
  ...(c.location ? { address: { '@type': 'PostalAddress', addressLocality: c.location, addressCountry: 'NP' } } : {}),
  ...(c.affiliation ? { parentOrganization: { '@type': 'EducationalOrganization', name: c.affiliation } } : {}),
};
---
<GlassLayout
  title={`${c.name} — MBBS Admission, Seats & Fees 2025 | NepalMBBS.in`}
  description={`${c.name}${c.location ? `, ${c.location}` : ''}: MBBS admission for Indian students${c.seats ? `, ${c.seats} foreign-quota seats` : ''}${c.affiliation ? `, affiliated to ${c.affiliation}` : ''}. Admission through MEC Nepal.`}
  path={path}
  schema={schema}
>
<div class="tab-pane on">
<div class="container">

  {/* DISCOVER — identity: which college, and the handful of real facts
      that place it, before anything else. */}
  <CollegeHero college={c} />

  {/* UNDERSTAND — the record itself, unchanged in substance from before
      this phase; still the page's single source of verified fact. */}
  <div class="doc rev" style="margin-top:28px">
    <div class="doc-head">
      <h2 class="doc-title">Record</h2>
      <span class="doc-kicker">{shortName}</span>
    </div>
    <div class="doc-body">
      <div class="doc-rows">
        {record.map(([label, value]) => (
          <div class="doc-row">
            <span class="doc-label">{label}</span>
            {value
              ? <span class="doc-value">{value}</span>
              : <span class="doc-value doc-value--unknown">Not on record — ask us</span>}
          </div>
        ))}
        <div class="doc-row">
          <span class="doc-label">Tuition fee</span>
          <span class="doc-value doc-value--unknown">
            Set per intake — <a href="/counseling">ask us for the current structure</a>
          </span>
        </div>
        {c.website && (
          <div class="doc-row">
            <span class="doc-label">Official website</span>
            <span class="doc-value">
              <a href={c.website} target="_blank" rel="noopener">{c.website.replace(/^https?:\/\//, '')} ↗</a>
            </span>
          </div>
        )}
      </div>
    </div>
    <p class="doc-source">
      Compiled from the Medical Education Commission (MEC) Nepal 2025-26 intake
      and the college's own published information.
      {c.website
        ? <> The college publishes its own details at <a href={c.website} target="_blank" rel="noopener">{c.website.replace(/^https?:\/\//, '')} ↗</a>.</>
        : <> We do not have an official website on file for this institution.</>}
      Record last reviewed {REVIEWED}.
    </p>
  </div>

  {/* UNDERSTAND, continued — the same real-data map every other page uses,
      reused rather than rebuilt, now opened straight to this one college
      among the other 26. Skipped entirely for the one college whose
      location string doesn't currently match a places.json entry (see
      TECHNICAL_DEBT.md) rather than showing a map with nothing marked. */}
  {hasCoord && (
    <div class="rev" style="margin-top:28px">
      <CollegeMap
        highlight={c.slug}
        variant="compact"
        sectionId="college-map"
        headOverride={{
          eyebrow: 'Where it is',
          title: shortName,
          lead: `${c.location} — one of ${plottedCount} MEC-approved colleges plotted here by where they actually sit. Hover any other point to compare positions, or open its own record.`,
        }}
      />
    </div>
  )}

  {/* EXPERIENCE — real visual evidence, shown before the academic path is
      described in words: this college's own video if the admin panel has
      one on file (site_videos, filtered to this college's category — see
      src/data/video-categories.json), populated client-side by
      college-video.js exactly the way /videos itself renders one, or an
      honest "none yet" state with a link into the fuller library. Never a
      stock or generic clip: the empty state says plainly that nothing is
      filed here yet, the same rule college-photo.js already follows for
      the hero photo. Hidden until the script resolves either way; a
      noscript fallback covers the no-JS case with a plain link instead of
      silence. */}
  <div class="doc rev" style="margin-top:28px">
    <div class="doc-head">
      <h2 class="doc-title">See {shortName}</h2>
      <span class="doc-kicker">Campus &amp; clinical video</span>
    </div>
    <div class="doc-body">
      <div id="college-video" data-video-category={videoCategory} data-college-name={shortName} hidden></div>
      <noscript>
        <div class="doc-empty">
          <p class="doc-empty-body">
            Video for {shortName}, where we have it, is in our
            {' '}<a href={videoCategory ? `/videos?college=${encodeURIComponent(videoCategory)}` : '/videos'}>video library</a>.
          </p>
        </div>
      </noscript>
    </div>
  </div>

  {/* EXPERIENCE, continued — the academic path and the hospital/clinical relationship,
      as a sequence rather than as more rows in the record above. Every step
      is knowledge.json's own already-sourced answer, read in order; nothing
      here is specific to this one college except, where the college's own
      name says so, that it names its own teaching hospital. */}
  <div class="doc rev" style="margin-top:28px">
    <div class="doc-head">
      <h2 class="doc-title">Your years at {shortName}</h2>
      <span class="doc-kicker">5.5 years, in order</span>
    </div>
    <div class="doc-body">
      <ol class="doc-steps">
        {academicSteps.map((s) => (
          <li class="doc-step">
            <h3 class="doc-step-title">{s.title}</h3>
            <p class="doc-step-body">{s.body}</p>
            <a href={s.source.url} target="_blank" rel="noopener" class="card-link">{s.source.name} ↗</a>
          </li>
        ))}
      </ol>
    </div>
    <p class="doc-source">
      This sequence is set by Nepal Medical Council and National Medical
      Commission (India) regulation, not by {shortName} individually — it is
      the same for every MEC-approved college. {hospitalInName
        ? <>{shortName}'s own name names its teaching hospital; we have no further detail on file about its size or case mix.</>
        : <>We do not have this college's specific teaching hospital on file — ask us, or ask the college directly.</>}
    </p>
  </div>

  {/* VERIFY — the caveats that keep the record above honest. Unchanged in
      substance from before this phase. */}
  {c.seatsSource && (
    <div class="doc-note rev" style="margin-top:24px">
      <strong>About the seat figure.</strong> {c.seats} is this college's
      allocation for <strong>{c.seatsSource.category}</strong> at the
      <strong> {c.seatsSource.round}</strong> of the {c.seatsSource.intake} intake,
      taken from the Medical Education Commission's own published matrix.
      It is not a permanent number: allocations are published per intake, and
      later matching rounds can change them. Seats also divide across foreign,
      paying, scholarship and army categories — this is the foreign one, which
      is the figure that applies to an Indian applicant. Confirm the current
      position for your own year at
      <a href="https://entrance.mec.gov.np" target="_blank" rel="noopener">entrance.mec.gov.np ↗</a>.
    </div>
  )}

  <div class="doc-note rev" style="margin-top:24px">
    <strong>We do not publish a fee figure for {shortName}.</strong> Fees and
    seat allocation are set each intake by MEC Nepal and the college, and a
    number that is stale by the time you read it is worse than no number. We
    will give you the current structure in writing on a call.
  </div>

  {/* DECIDE — the natural place to leave this one record and either see it
      next to others (comparison) or go back to choosing among all of them
      (discovery). Both already exist; this just connects them here. */}
  <div class="rev" style="margin-top:28px;display:flex;gap:14px;flex-wrap:wrap;align-items:center">
    <a href={`/colleges/compare?c=${encodeURIComponent(c.slug)}`} class="college-link">Compare {shortName} with other colleges →</a>
    <a href="/colleges" class="college-link">← Back to all colleges</a>
  </div>

  {/* ENQUIRE — the one conversion moment on this page, placed after the
      record, the years and the caveats rather than before them, so it reads
      as the next step once you understand the college, not a sales button
      competing with the facts above it. Deliberately still .college-enquire,
      not the site's reserved .gl-crystal treatment — premium.css §17 keeps
      that crystal fill to the two highest-visibility, sitewide conversion
      points (nav + homepage hero); using it again here, once per college,
      would be exactly the dilution that restraint exists to prevent. */}
  <div class="doc rev" style="margin-top:32px">
    <div class="doc-body" style="display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:space-between">
      <p style="margin:0;max-width:44ch">
        Considered the record, the path and the caveats above? The next step
        is a call, not another page.
      </p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:center">
        <button class="college-enquire" data-act="click"
                data-do={JSON.stringify([["enquireCollege", c.enquiryName || c.name]])}>
          Enquire about {shortName}
        </button>
        <a href="/admission-process" class="college-link">How the MEC process works →</a>
      </div>
    </div>
  </div>

</div>
</div>
</GlassLayout>
