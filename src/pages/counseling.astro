---
import GlassLayout from '../layouts/GlassLayout.astro';
---
<GlassLayout
  title="Free MBBS Nepal Counseling for NEET Qualified Students | NepalMBBS.in"
  description="Book a free 30-minute counseling session. Honest guidance on MBBS in Nepal based strictly on official NMC India and MEC Nepal rules. No commitment."
  path="/counseling"
>
<div class="tab-pane on" id="pane-counsel">
<div class="counsel-bg">
  <div class="counsel-grid">
    <div class="counsel-left rev">
      {/* The inline colour pinned this to --gold, which bridge.css aliases to
          --brand. --brand is the fill colour and measures 4.44:1 as text on
          this surface — just under AA. --brand-text exists precisely for this
          case (engine.css: "brand as TEXT — 4.5:1"), and chrome.css already
          applies it to .eyebrow, so the override only made it worse. */}
      <div class="eyebrow">Book a Session</div>
      <h2>Free Counseling —<br>No Pressure</h2>
      <p>Our experienced counselors discuss your NEET score and options honestly — based strictly on official NMC India and MEC Nepal guidelines. No commitment required. No false promises. Ever.</p>
      <div class="counsel-btns">
        <a id="calendly-link" href="https://calendly.com/nepalmedtech/30min" target="_blank" rel="noopener" class="counsel-btn cb-cal">
          <div class="counsel-btn-icon"><svg width="22" height="22" viewBox="0 0 24 24"><path fill="#4285f4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34a853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#fbbc05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#ea4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg></div>
          <div class="counsel-btn-text"><h4>Book via Calendly</h4><p>Schedule a free 30-minute session</p></div>
        </a>
        <a id="counsel-wa-chat" href="https://wa.me/917080800888?text=I%20want%20to%20book%20a%20free%20Nepal%20MBBS%20counseling%20session." target="_blank" rel="noopener" class="counsel-btn cb-wa">
          <div class="counsel-btn-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.549 4.116 1.512 5.845L.057 23.273a.75.75 0 00.924.924l5.428-1.455A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22.5c-1.978 0-3.83-.53-5.42-1.452l-.388-.229-4.02 1.078 1.078-4.02-.229-.388A10.45 10.45 0 011.5 12C1.5 6.201 6.201 1.5 12 1.5S22.5 6.201 22.5 12 17.799 22.5 12 22.5z"/></svg></div>
          <div class="counsel-btn-text"><h4>WhatsApp Chat</h4><p>Message us anytime — quick responses</p></div>
        </a>
        <a id="counsel-wa-call" href="https://wa.me/917080800888?call" target="_blank" rel="noopener" class="counsel-btn cb-wc">
          <div class="counsel-btn-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>
          <div class="counsel-btn-text"><h4>WhatsApp Call</h4><p>Direct call — works internationally too</p></div>
        </a>
      </div>
      <p style="margin-top:18px;font-size:12px;color:rgba(255,255,255,.3)">📞 <span id="counsel-phone">+91 70808 00888</span> &nbsp;|&nbsp; 📧 info@nepalmbbs.in</p>
    </div>
    <div class="counsel-card rev">
      <div class="counsel-card-title">Quick Enquiry</div>
      <div class="counsel-card-sub">Fill in — we'll contact you on your preferred channel within 2 hours</div>
      <div id="cform-area">
        <div class="ff"><label style="color:rgba(255,255,255,.5)">Student Name</label><input id="c-name" type="text" placeholder="Full name" autocomplete="name"></div>
        <div class="ff2">
          <div class="ff"><label style="color:rgba(255,255,255,.5)">WhatsApp No.</label><input id="c-phone" type="tel" placeholder="10 digits" maxlength="10" inputmode="numeric"></div>
          <div class="ff"><label style="color:rgba(255,255,255,.5)">NEET Score</label><input id="c-neet" type="number" placeholder="Score" inputmode="numeric"></div>
        </div>
        <div class="ff2">
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">State</label>
            <select id="c-state" data-act="change" data-do='[["updateCities","c-state","c-city"]]'>
              <option value="">Select State</option>
              <option>Maharashtra</option><option>Uttar Pradesh</option><option>Bihar</option>
              <option>Rajasthan</option><option>Madhya Pradesh</option><option>Gujarat</option>
              <option>Delhi</option><option>Haryana</option><option>Punjab</option>
              <option>West Bengal</option><option>Tamil Nadu</option><option>Karnataka</option>
              <option>Andhra Pradesh</option><option>Telangana</option><option>Kerala</option>
              <option>Odisha</option><option>Jharkhand</option><option>Chhattisgarh</option>
              <option>Assam</option><option>Uttarakhand</option><option>Other</option>
            </select>
          </div>
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">City</label>
            <select id="c-city"><option value="">— Select State First —</option></select>
          </div>
        </div>
        <div class="ff2">
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">NEET Attempt</label>
            <select id="c-attempt">
              <option value="">Select</option>
              <option value="1st">1st Attempt (Fresher)</option>
              <option value="2nd">2nd Attempt</option>
              <option value="3rd">3rd Attempt</option>
              <option value="4th+">4th+ Attempt</option>
            </select>
          </div>
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">12th PCB %</label>
            <select id="c-pcb">
              <option value="">Select</option>
              <option>90%+</option><option>80-89%</option><option>70-79%</option>
              <option>60-69%</option><option>50-59%</option><option>Below 50%</option>
            </select>
          </div>
        </div>
        <div class="ff">
          <label style="color:rgba(255,255,255,.5)">Preferred Contact Method</label>
          <select id="c-mode">
            <option value="WhatsApp Chat">WhatsApp Chat</option>
            <option value="WhatsApp Call">WhatsApp Call</option>
            <option value="Phone Call">Phone Call</option>
            <option value="Calendly Session">Calendly Session</option>
            <option value="Email">Email</option>
          </select>
        </div>
        <button class="sbtn" id="cf-btn" data-act="click" data-do='[["submitLead","counsel"]]'>Send Enquiry →</button>
      </div>
      {/* This is the one screen every enquiry ends on, and it was unreadable:
          the paragraph carried an inline rgba(255,255,255,.6) from the dark
          build, which on the light page is white on white. tests/audit.mjs
          never saw it because the block is display:none until the form is
          submitted — the contrast pass only ever measures the default state.

          Also retoned: an exclamation mark and a 📩 belong to a different
          register than the rest of this site, and "Enquiry Received!" tells
          the reader less than saying what happens next and when. */}
      <div class="form-success" id="cform-success">
        <h3>Your enquiry has been received</h3>
        <p>A counsellor will contact you on your preferred channel within two working hours. If your enquiry arrives outside working hours, it will be answered the following morning.</p>
      </div>
    </div>
  </div>
</div>
</div>
</GlassLayout>
