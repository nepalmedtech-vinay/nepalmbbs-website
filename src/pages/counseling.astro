---
import GlassLayout from '../layouts/GlassLayout.astro';
import journeyStages from '../data/journey-stages.json';

// The exact 8-stage vocabulary the student portal already shows a real
// applicant (public/assets/js/portal.js's own STAGES array — same keys,
// same order, same wording). Kept as a separate small JSON file rather
// than hand-retyped here so there is one canonical copy of the words, even
// though portal.js (a classic script, not built through Astro) can't
// import it directly — if that array's wording or order ever changes,
// this file needs the matching update. Nothing here is invented: this is
// the real lifecycle `applications.stage` already enforces in the
// database (supabase/migrations/0002_admission_platform.sql).
---
<GlassLayout
  title="Free MBBS Nepal Counseling for NEET Qualified Students | NepalMBBS.in"
  description="Book a free 30-minute counseling session. Honest guidance on MBBS in Nepal based strictly on official NMC India and MEC Nepal rules. No commitment."
  path="/counseling"
>
<div class="tab-pane on" id="pane-counsel">
<div class="counsel-bg">
  <div class="counsel-grid">
    <div class="counsel-left rev">
      {/* The inline colour pinned this to --gold, which bridge.css aliases to
          --brand. --brand is the fill colour and measures 4.44:1 as text on
          this surface — just under AA. --brand-text exists precisely for this
          case (engine.css: "brand as TEXT — 4.5:1"), and chrome.css already
          applies it to .eyebrow, so the override only made it worse. */}
      <div class="eyebrow">Book a Session</div>
      <h2>Free Counseling —<br>No Pressure</h2>
      <p>Our experienced counselors discuss your NEET score and options honestly — based strictly on official NMC India and MEC Nepal guidelines. No commitment required. No false promises. Ever.</p>

      {/* Phase 5F: a scannable trust strip before the ask, reusing the exact
          pill grammar .jr-path-step already establishes further down this
          same page — a second place for the same signature, not a new one.
          All three facts already exist in the paragraph above; this makes
          them scannable in half a second for a visitor who came in unsure. */}
      <ul class="assure-row rev" role="list">
        <li class="assure-chip">Free, always</li>
        <li class="assure-chip">30-minute session</li>
        <li class="assure-chip">Based only on NMC/MEC rules</li>
      </ul>

      {/* Phase 5F: not sure you qualify is the moment before a student ever
          reaches the form below — UNCERTAINTY before CONFIDENCE. Same
          calc-wrap component and checkEligibility() as /neet-calculator,
          not a second system: these ids only ever exist once per page. */}
      <div class="calc-wrap calc-wrap--compact rev">
        <h3>Not sure you qualify? Check first</h3>
        <p>Two minutes, against the published rules — before you fill in the form below.</p>
        <div class="calc-grid">
          <div class="cfield"><label for="calc-percentile">NEET Percentile</label><input type="number" id="calc-percentile" placeholder="e.g. 62.5" min="0" max="100" step="0.01" inputmode="decimal"></div>
          <div class="cfield"><label for="calc-cat">Category</label><select id="calc-cat"><option value="gen">General</option><option value="obc">OBC</option><option value="sc">SC/ST</option></select></div>
          <div class="cfield"><label for="calc-pcb">12th PCB Aggregate</label><select id="calc-pcb"><option value="">Select</option><option>90%+</option><option>80-89%</option><option>70-79%</option><option>60-69%</option><option>50-59%</option><option>Below 50%</option></select></div>
        </div>
        <button class="calc-btn" data-act="click" data-do='[["checkEligibility"]]'>Check My Eligibility →</button>
        <div class="calc-result" id="calc-result"></div>
      </div>

      <div class="counsel-btns">
        <a id="calendly-link" href="https://calendly.com/nepalmedtech/30min" target="_blank" rel="noopener" class="counsel-btn cb-cal">
          <div class="counsel-btn-icon"><svg width="22" height="22" viewBox="0 0 24 24"><path fill="#4285f4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34a853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#fbbc05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#ea4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg></div>
          <div class="counsel-btn-text"><h4>Book via Calendly</h4><p>Schedule a free 30-minute session</p></div>
        </a>
        <a id="counsel-wa-chat" href="https://wa.me/917080800888?text=I%20want%20to%20book%20a%20free%20Nepal%20MBBS%20counseling%20session." target="_blank" rel="noopener" class="counsel-btn cb-wa">
          <div class="counsel-btn-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.549 4.116 1.512 5.845L.057 23.273a.75.75 0 00.924.924l5.428-1.455A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22.5c-1.978 0-3.83-.53-5.42-1.452l-.388-.229-4.02 1.078 1.078-4.02-.229-.388A10.45 10.45 0 011.5 12C1.5 6.201 6.201 1.5 12 1.5S22.5 6.201 22.5 12 17.799 22.5 12 22.5z"/></svg></div>
          <div class="counsel-btn-text"><h4>WhatsApp Chat</h4><p>Message us anytime — quick responses</p></div>
        </a>
        <a id="counsel-wa-call" href="https://wa.me/917080800888?call" target="_blank" rel="noopener" class="counsel-btn cb-wc">
          <div class="counsel-btn-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg></div>
          <div class="counsel-btn-text"><h4>WhatsApp Call</h4><p>Direct call — works internationally too</p></div>
        </a>
      </div>
      <p style="margin-top:18px;font-size:12px;color:rgba(255,255,255,.3)">📞 <span id="counsel-phone">+91 70808 00888</span> &nbsp;|&nbsp; 📧 info@nepalmbbs.in</p>
    </div>
    <div class="counsel-right">
    <div class="counsel-card rev" data-scroll-target>
      <div class="counsel-card-title">Quick Enquiry</div>
      <div class="counsel-card-sub">Fill in — we'll contact you on your preferred channel within 2 hours</div>
      <div id="cform-area">
        <div class="ff"><label style="color:rgba(255,255,255,.5)">Student Name</label><input id="c-name" type="text" placeholder="Full name" autocomplete="name"></div>
        <div class="ff2">
          <div class="ff"><label style="color:rgba(255,255,255,.5)">WhatsApp No.</label><input id="c-phone" type="tel" placeholder="10 digits" maxlength="10" inputmode="numeric"></div>
          <div class="ff"><label style="color:rgba(255,255,255,.5)">NEET Score</label><input id="c-neet" type="number" placeholder="Score" inputmode="numeric"></div>
        </div>
        <div class="ff2">
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">State</label>
            <select id="c-state" data-act="change" data-do='[["updateCities","c-state","c-city"]]'>
              <option value="">Select State</option>
              <option>Maharashtra</option><option>Uttar Pradesh</option><option>Bihar</option>
              <option>Rajasthan</option><option>Madhya Pradesh</option><option>Gujarat</option>
              <option>Delhi</option><option>Haryana</option><option>Punjab</option>
              <option>West Bengal</option><option>Tamil Nadu</option><option>Karnataka</option>
              <option>Andhra Pradesh</option><option>Telangana</option><option>Kerala</option>
              <option>Odisha</option><option>Jharkhand</option><option>Chhattisgarh</option>
              <option>Assam</option><option>Uttarakhand</option><option>Other</option>
            </select>
          </div>
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">City</label>
            <select id="c-city"><option value="">— Select State First —</option></select>
          </div>
        </div>
        <div class="ff2">
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">NEET Attempt</label>
            <select id="c-attempt">
              <option value="">Select</option>
              <option value="1st">1st Attempt (Fresher)</option>
              <option value="2nd">2nd Attempt</option>
              <option value="3rd">3rd Attempt</option>
              <option value="4th+">4th+ Attempt</option>
            </select>
          </div>
          <div class="ff">
            <label style="color:rgba(255,255,255,.5)">12th PCB %</label>
            <select id="c-pcb">
              <option value="">Select</option>
              <option>90%+</option><option>80-89%</option><option>70-79%</option>
              <option>60-69%</option><option>50-59%</option><option>Below 50%</option>
            </select>
          </div>
        </div>
        <div class="ff">
          <label style="color:rgba(255,255,255,.5)">Preferred Contact Method</label>
          <select id="c-mode">
            <option value="WhatsApp Chat">WhatsApp Chat</option>
            <option value="WhatsApp Call">WhatsApp Call</option>
            <option value="Phone Call">Phone Call</option>
            <option value="Calendly Session">Calendly Session</option>
            <option value="Email">Email</option>
          </select>
        </div>
        <button class="sbtn" id="cf-btn" data-act="click" data-do='[["submitLead","counsel"]]'>Send Enquiry →</button>
      </div>
      {/* This is the one screen every enquiry ends on, and it was unreadable:
          the paragraph carried an inline rgba(255,255,255,.6) from the dark
          build, which on the light page is white on white. tests/audit.mjs
          never saw it because the block is display:none until the form is
          submitted — the contrast pass only ever measures the default state.

          Also retoned: an exclamation mark and a 📩 belong to a different
          register than the rest of this site, and "Enquiry Received!" tells
          the reader less than saying what happens next and when. */}
      {/* Phase 5F: the "what happens" content that used to live only here
          moved to .counsel-journey below, always visible — see that block's
          own comment for why. This panel now stays purely the immediate
          confirmation, plus one line pointing at what's already on screen
          rather than re-stating it. */}
      <div class="form-success" id="cform-success">
        <h3>Your enquiry has been received</h3>
        <p>A counsellor will contact you on your preferred channel within two working hours. If your enquiry arrives outside working hours, it will be answered the following morning.</p>
        <p class="jr-live-note">The first step below is already underway — no need to refresh or check back.</p>
      </div>
    </div>

    {/* Phase 5F: this used to be the .jr block inside #cform-success, visible
        only after a real form submit. That hid the single most confidence-
        building content on the page — exactly what a counsellor does with
        your number, and the real 8-stage path after — from the ~95% of
        visitors who read before they'll ever type a phone number in. Made
        permanently visible instead; a genuine submit (leads.js) marks the
        first step/chip as actually underway rather than re-rendering this
        content a second time. Nothing here is invented: same real seeded
        follow-up sequence (supabase/migrations/0004_lead_intake.sql) and the
        same literal 8-stage vocabulary portal.js already shows a real
        applicant (see the import at the top of this file). */}
    <div class="counsel-journey m-rise">
      <div class="jr-label">What happens after you enquire</div>
      <p class="counsel-journey-lead">Nothing manual on your side — this is what runs automatically the moment you press "Send Enquiry."</p>
      <ol class="jr-next">
        <li><span class="jr-next-n"></span><span>A counsellor reviews your NEET score and what you're looking for</span></li>
        <li><span class="jr-next-n"></span><span>You're contacted on the channel you choose above</span></li>
        <li><span class="jr-next-n"></span><span>You get a written eligibility summary — the rule, not a promise</span></li>
        <li><span class="jr-next-n"></span><span>If we haven't heard back, we check in — you never have to chase us</span></li>
      </ol>

      <div class="jr-label jr-label--path">The path ahead, if you proceed</div>
      <ol class="jr-path">
        {journeyStages.map((s) => (
          <li class="jr-path-step">{s.label}</li>
        ))}
      </ol>
      <p class="jr-note">Once your enquiry becomes an application, you get a private link that tracks it against this same list — kept current by your counsellor as it actually happens, not a status page that goes stale.</p>
    </div>
    </div>
  </div>
</div>
</div>

<style>
  /* Phase 5F — layout for the right-hand column: the enquiry form and the
     always-visible "what happens" card stack as two siblings inside one
     flex column, rather than as two direct children of .counsel-grid's own
     2-column grid. A grid with unequal-height rows would otherwise place a
     third direct child in a new implicit row that only starts once the
     *tallest* row across both columns finishes — reopening the exact
     "large dead gap" problem this phase set out to close, just moved
     further down the page instead of removed. */
  .counsel-right {
    display: flex;
    flex-direction: column;
    gap: var(--s-6, 2rem);
  }
  /* base.css's .counsel-card carries position:sticky, built for when this
     column held nothing else and had a lot of empty space beside a much
     taller left column to fill. It no longer does (see .counsel-journey
     below) — and a sticky, 94%-opaque card left free to float over its own
     sibling as the page scrolls visibly ghosts through it. Static removes
     the conflict; the column is close enough in height to the left one now
     that the float-while-scrolling affordance isn't needed anyway. */
  .counsel-right .counsel-card {
    position: static;
  }

  /* Phase 5F — trust strip ahead of the eligibility check: reuses the exact
     pill grammar .jr-path-step establishes below (border, ink-3 text, pill
     radius) rather than inventing a second chip language on the same page. */
  .assure-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 var(--s-6, 1.75rem);
    padding: 0;
    list-style: none;
  }
  .assure-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    border-radius: var(--r-pill);
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--g-ink-2);
    background: color-mix(in oklab, var(--brand) 6%, var(--m-fill-solid));
    border: 1px solid var(--m-hairline);
    white-space: nowrap;
  }

  /* Phase 5F — the persistent "what happens" card. Visually matches
     .counsel-card (same fill/border/radius/shadow tokens) without inheriting
     its position:sticky — two sticky siblings in the same column would
     fight for the same top offset instead of stacking. */
  .counsel-journey {
    background: var(--m-fill-solid);
    border: 1px solid var(--m-hairline);
    border-radius: var(--r-lg);
    box-shadow: var(--sd-3);
    padding: var(--s-6, 2rem);
  }
  .counsel-journey-lead {
    font-size: var(--t-sm);
    line-height: var(--lh-body);
    color: var(--g-ink-3);
    margin: 0 0 var(--s-5, 1.25rem);
  }
  .jr-live-note {
    margin-top: var(--s-3, 0.75rem);
    font-size: var(--t-xs);
    color: var(--brand-text);
    font-weight: 600;
  }

  /* Phase 5B — the enquiry-success "what happens next" reveal.
     .jr-next reuses admission-process.astro's own ordinal-spine language
     (premium.css §8 .doc-steps) at a compact scale — the site's own
     established "this is a sequence, not a list" motif, not a new one.
     .jr-path echoes the homepage chapter rail's dot-and-line grammar
     (premium.css §22 .hp-story) as a horizontal wrapped strip instead of
     a fixed vertical one — the same signature applied a second place,
     which is what makes it a signature rather than a one-off effect. */
  .jr { margin-top: var(--s-6, 1.75rem); }

  .jr-label {
    font-size: var(--t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--g-ink-3);
    margin-bottom: var(--s-3, 0.75rem);
  }
  .jr-label--path { margin-top: var(--s-6, 1.75rem); }

  .jr-next {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--s-3, 0.7rem);
    counter-reset: jrstep;
  }
  .jr-next li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s-3, 0.7rem);
    font-size: var(--t-sm);
    color: var(--g-ink-2);
    line-height: var(--lh-body);
  }
  .jr-next-n {
    counter-increment: jrstep;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    font-size: 0.65rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--brand-text);
    background: color-mix(in oklab, var(--brand) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand) 28%, transparent);
  }
  .jr-next-n::before { content: counter(jrstep); }

  /* Set by leads.js on a real submit — the first step is no longer generic,
     it's genuinely underway for this enquiry. */
  .jr-next li.is-done .jr-next-n {
    color: var(--brand-ink);
    background: var(--brand);
    border-color: var(--brand);
  }
  .jr-next li.is-done .jr-next-n::before { content: '✓'; }

  /* The path ahead: a wrapped chip sequence, not a table of stage names.
     A chevron between chips (::after on every item but the last) reads
     as "leads to" without a connecting line fighting the wrap. */
  .jr-path {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.3rem;
  }
  .jr-path-step {
    position: relative;
    padding: 0.32rem 0.65rem;
    border-radius: var(--r-pill);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--g-ink-3);
    background: color-mix(in oklab, var(--g-ink) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--g-ink) 12%, transparent);
    white-space: nowrap;
  }
  .jr-path-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -0.95rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.65rem;
    color: color-mix(in oklab, var(--g-ink) 22%, transparent);
  }
  .jr-path-step.is-now {
    color: var(--brand-text);
    background: color-mix(in oklab, var(--brand) 10%, transparent);
    border-color: color-mix(in oklab, var(--brand) 34%, transparent);
    font-weight: 600;
  }

  .jr-note {
    margin: var(--s-4, 1rem) 0 0;
    font-size: var(--t-xs);
    line-height: var(--lh-body);
    color: var(--g-ink-3);
    max-width: 42ch;
  }
</style>
</GlassLayout>
