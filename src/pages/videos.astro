---
import GlassLayout from '../layouts/GlassLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getColleges } from '../lib/colleges.js';
import videoCategories from '../data/video-categories.json';

// Phase 5E: tabs generated from the shared video-categories.json (one
// college → one code → one label, defined once) instead of 18 hand-typed
// buttons — the previous markup only covered 18 of the 27 colleges, so 9
// had no tab and therefore no way for a visitor to reach a video filed
// under them at all, even if a staff member had already added one via the
// admin panel. Ordered to match colleges.json (the site's own canonical
// order) rather than the old list's original ad-hoc order.
const colleges = await getColleges();
const tabs = colleges
  .filter((c) => videoCategories[c.slug])
  .map((c) => ({ code: videoCategories[c.slug].code, label: videoCategories[c.slug].label }));
---
<GlassLayout
  title="MBBS in Nepal — Campus Tours, Student Reviews & Process Videos | NepalMBBS.in"
  description="Video guides on MBBS in Nepal: campus tours, current student experiences and walkthroughs of the MEC Nepal admission process."
  path="/videos"
>
<div class="tab-pane on" id="pane-videos">
<div class="container">
  {/* "Official photos shown when video unavailable" was dropped from this
      standfirst — that fallback was a stock-photo slideshow removed for
      misrepresenting unrelated buildings as "official campus photos"
      (see the comment in colleges.js); nothing has replaced it, so the
      old copy was describing a feature that no longer exists. */}
  <PageHeader eyebrow="College Video Library" lead="Select a college to watch campus tours and student reviews." threeD>Explore Nepal Medical Colleges</PageHeader>
  <div class="college-selector rev" style="margin-top:28px">
    <div class="college-sel-label">Select a College to Explore</div>
    <div class="college-tabs-wrap" id="college-tabs">
      <button class="college-tab on" data-act="click" data-do='[["selectCollege","@el","all"]]'>🏛️ All Videos</button>
      {tabs.map((t) => (
        <button class="college-tab" data-act="click" data-do={`[["selectCollege","@el","${t.code}"]]`}>{t.label}</button>
      ))}
    </div>
  </div>
  <div id="videos-container" style="margin-top:20px">
    <div class="vid-grid" id="all-videos-grid"></div>
  </div>
  <div class="vid-drive-card rev" style="margin-top:24px">
    <h4>Campus footage and process guides</h4>
    <p>We publish video only where we have filmed it ourselves or the college has supplied it. If there is nothing here for a college you are considering, ask us — we will tell you what we hold, including where we hold nothing.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:14px">
      <a href="https://drive.google.com/drive/folders/1W-q-NqJwrkJ1K8EirJvphAwW-xsMF4cQ" target="_blank" rel="noopener" class="btn-primary" style="font-size:13px;padding:10px 20px">📂 Full Video Library →</a>
      <a id="vid-wa-req" href="https://wa.me/917080800888?text=Hi!%20I%20want%20to%20request%20a%20campus%20video%20for%20Nepal%20MBBS" target="_blank" rel="noopener" class="btn-glass btn-wa-req">Request on WhatsApp</a>
      <a href="mailto:info@nepalmbbs.in?subject=Video Request - Nepal MBBS" class="btn-glass btn-req-email">Request via Email</a>
    </div>
  </div>
</div>
</div>
</GlassLayout>
