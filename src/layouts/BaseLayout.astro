---
import { SITE } from '../lib/routes.js';
import Loader from '../components/Loader.astro';
import Navbar from '../components/Navbar.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Ticker from '../components/Ticker.astro';
import ContactBar from '../components/ContactBar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ChatWidget from '../components/ChatWidget.astro';
import AdminPanel from '../components/AdminPanel.astro';

const {
  title,
  description,
  path,
  isHome = false,
  ogImage = 'https://images.unsplash.com/photo-1605640840605-14ac1855827b?fm=webp&w=1920&q=95&fit=crop&auto=format&ixlib=rb-4.1.0',
  schema = null,
} = Astro.props;

// Canonical is built from the route rather than hardcoded, so a page can never
// ship pointing at "/" — the mistake the single-page build could not even make,
// and the one most likely to be made now that there are ten of them.
const canonical = new URL(path, SITE).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

<meta property="og:type" content={isHome ? 'website' : 'article'}>
<meta property="og:site_name" content="NepalMBBS.in">
<meta property="og:locale" content="en_IN">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

<meta name="theme-color" content="#0e2347">
<link rel="manifest" href="/manifest.json">
<link rel="icon" href="/assets/brand/icon-192.png" sizes="192x192" type="image/png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">

<link rel="preconnect" href="https://images.unsplash.com" crossorigin>
<link rel="dns-prefetch" href="https://images.unsplash.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/base.css">
<link rel="stylesheet" href="/assets/css/components.css">
<link rel="stylesheet" href="/assets/css/sections.css">
<link rel="stylesheet" href="/assets/css/trust.css">

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>

<Loader />
<Navbar />
<MobileMenu />

<slot />

<Ticker />
<ContactBar />
<Footer />
<WhatsAppFloat />
<ChatWidget />
<AdminPanel />

<!-- Classic scripts, in this order. They are not modules on purpose: the
     markup still calls these functions from inline on* handlers, which needs
     them global. See docs/DESIGN-SYSTEM.md. -->
<script is:inline src="/assets/js/config.js"></script>
<script is:inline src="/assets/js/boot.js"></script>
<script is:inline src="/assets/js/i18n.js"></script>
<script is:inline src="/assets/js/navigation.js"></script>
<script is:inline src="/assets/js/leads.js"></script>
<script is:inline src="/assets/js/reveal.js"></script>
<script is:inline src="/assets/js/chatbot.js"></script>
<script is:inline src="/assets/js/hero.js"></script>
<script is:inline src="/assets/js/colleges.js"></script>
<script is:inline src="/assets/js/admin.js"></script>
<script is:inline src="/assets/js/effects.js"></script>
</body>
</html>
